{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalnawa.dev/schemas/creative-brief.schema.json",
  "title": "DigitalNawa Creative Brief",
  "type": "object",
  "$defs": {
    "base": {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved",
            "rejected",
            "superseded"
          ]
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "contract": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              }
            },
            "required": [
              "artifact_id",
              "contract",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "validation": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL",
                "NOT_VERIFIED",
                "BLOCKED"
              ]
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "error",
                      "warning",
                      "info"
                    ]
                  }
                },
                "required": [
                  "code",
                  "message",
                  "severity"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "status",
            "issues"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract_version",
        "project_id",
        "artifact_id",
        "created_at",
        "producer",
        "status",
        "source_artifacts",
        "validation"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/base"
    },
    {
      "type": "object",
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "enum": [
            "vertical",
            "square",
            "horizontal",
            "custom"
          ]
        },
        "duration_target_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "language": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          },
          "minItems": 1
        },
        "tone": {
          "type": "string",
          "minLength": 1
        },
        "call_to_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reference_materials": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uri": {
                "type": "string",
                "format": "uri"
              },
              "description": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              }
            },
            "required": [
              "uri",
              "kind"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "objective",
        "audience",
        "platform",
        "format",
        "duration_target_seconds",
        "language",
        "tone",
        "call_to_action",
        "content_constraints",
        "reference_materials"
      ]
    }
  ],
  "unevaluatedProperties": false
}
