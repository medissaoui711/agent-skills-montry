{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalnawa.dev/schemas/brand.schema.json",
  "title": "DigitalNawa Brand Contract",
  "type": "object",
  "$defs": {
    "base": {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved",
            "rejected",
            "superseded"
          ]
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "contract": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              }
            },
            "required": [
              "artifact_id",
              "contract",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "validation": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL",
                "NOT_VERIFIED",
                "BLOCKED"
              ]
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "error",
                      "warning",
                      "info"
                    ]
                  }
                },
                "required": [
                  "code",
                  "message",
                  "severity"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "status",
            "issues"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract_version",
        "project_id",
        "artifact_id",
        "created_at",
        "producer",
        "status",
        "source_artifacts",
        "validation"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/base"
    },
    {
      "type": "object",
      "properties": {
        "brand_id": {
          "type": "string",
          "minLength": 1
        },
        "brand_name": {
          "type": "string",
          "minLength": 1
        },
        "identity_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "source_of_truth": {
          "type": "object",
          "properties": {
            "repository_url": {
              "type": "string",
              "format": "uri"
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "asset_index_path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "repository_url",
            "ref",
            "asset_index_path"
          ],
          "additionalProperties": false
        },
        "approval_status": {
          "type": "string",
          "enum": [
            "UNVERIFIED",
            "PENDING",
            "APPROVED",
            "REJECTED"
          ]
        },
        "logo_assets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "asset_id": {
                "type": "string"
              },
              "uri": {
                "type": "string",
                "format": "uri"
              },
              "format": {
                "type": "string",
                "enum": [
                  "svg",
                  "png",
                  "webp",
                  "pdf"
                ]
              },
              "usage": {
                "type": "string"
              }
            },
            "required": [
              "asset_id",
              "uri",
              "format",
              "usage"
            ],
            "additionalProperties": false
          }
        },
        "color_palette": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string"
              },
              "value": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "source_ref": {
                "type": "string"
              }
            },
            "required": [
              "token",
              "value",
              "source_ref"
            ],
            "additionalProperties": false
          }
        },
        "typography": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string"
              },
              "family": {
                "type": "string"
              },
              "weight": {
                "type": "string"
              },
              "source_ref": {
                "type": "string"
              },
              "license_ref": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "family",
              "source_ref"
            ],
            "additionalProperties": false
          }
        },
        "visual_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "motion_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "intro_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outro_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_variations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "brand_id",
        "brand_name",
        "identity_version",
        "source_of_truth",
        "approval_status",
        "logo_assets",
        "color_palette",
        "typography"
      ]
    }
  ],
  "unevaluatedProperties": false
}
