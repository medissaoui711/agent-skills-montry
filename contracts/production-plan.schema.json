{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalnawa.dev/schemas/production-plan.schema.json",
  "title": "DigitalNawa Production Plan",
  "type": "object",
  "$defs": {
    "base": {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved",
            "rejected",
            "superseded"
          ]
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "contract": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              }
            },
            "required": [
              "artifact_id",
              "contract",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "validation": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL",
                "NOT_VERIFIED",
                "BLOCKED"
              ]
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "error",
                      "warning",
                      "info"
                    ]
                  }
                },
                "required": [
                  "code",
                  "message",
                  "severity"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "status",
            "issues"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract_version",
        "project_id",
        "artifact_id",
        "created_at",
        "producer",
        "status",
        "source_artifacts",
        "validation"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/base"
    },
    {
      "type": "object",
      "properties": {
        "composition_id": {
          "type": "string",
          "minLength": 1
        },
        "video": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "fps": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "duration_frames": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "width",
            "height",
            "fps",
            "duration_frames"
          ],
          "additionalProperties": false
        },
        "scenes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "scene_id": {
                "type": "string"
              },
              "from": {
                "type": "integer",
                "minimum": 0
              },
              "duration_frames": {
                "type": "integer",
                "minimum": 1
              },
              "component": {
                "type": "string"
              },
              "props": {
                "type": "object"
              },
              "asset_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "scene_id",
              "from",
              "duration_frames",
              "component",
              "props",
              "asset_ids"
            ],
            "additionalProperties": false
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "asset_id": {
                "type": "string"
              },
              "uri": {
                "type": "string",
                "format": "uri"
              },
              "kind": {
                "type": "string"
              },
              "license_status": {
                "type": "string",
                "enum": [
                  "verified",
                  "unverified",
                  "not_required"
                ]
              }
            },
            "required": [
              "asset_id",
              "uri",
              "kind",
              "license_status"
            ],
            "additionalProperties": false
          }
        },
        "audio_tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "asset_id": {
                "type": "string"
              },
              "from": {
                "type": "integer",
                "minimum": 0
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "asset_id",
              "from",
              "volume"
            ],
            "additionalProperties": false
          }
        },
        "render_profile": {
          "type": "object",
          "properties": {
            "codec": {
              "type": "string"
            },
            "pixel_format": {
              "type": "string"
            },
            "quality": {
              "type": "string",
              "enum": [
                "preview",
                "production"
              ]
            }
          },
          "required": [
            "codec",
            "quality"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "composition_id",
        "video",
        "scenes",
        "assets",
        "audio_tracks",
        "render_profile"
      ]
    }
  ],
  "unevaluatedProperties": false
}
