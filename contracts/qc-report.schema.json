{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalnawa.dev/schemas/qc-report.schema.json",
  "title": "DigitalNawa QC Report",
  "type": "object",
  "$defs": {
    "base": {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "approved",
            "rejected",
            "superseded"
          ]
        },
        "source_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "contract": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              }
            },
            "required": [
              "artifact_id",
              "contract",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "validation": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL",
                "NOT_VERIFIED",
                "BLOCKED"
              ]
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "error",
                      "warning",
                      "info"
                    ]
                  }
                },
                "required": [
                  "code",
                  "message",
                  "severity"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "status",
            "issues"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract_version",
        "project_id",
        "artifact_id",
        "created_at",
        "producer",
        "status",
        "source_artifacts",
        "validation"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/base"
    },
    {
      "type": "object",
      "properties": {
        "overall_status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_VERIFIED",
            "BLOCKED"
          ]
        },
        "reviewed_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifact_id": {
                "type": "string"
              },
              "contract": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "artifact_id",
              "contract",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "check_id": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL",
                  "NOT_VERIFIED",
                  "BLOCKED"
                ]
              },
              "evidence": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "major",
                  "minor",
                  "info"
                ]
              }
            },
            "required": [
              "check_id",
              "category",
              "status",
              "evidence",
              "reason",
              "severity"
            ],
            "additionalProperties": false
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "overall_status",
        "reviewed_artifacts",
        "checks",
        "recommendations"
      ]
    }
  ],
  "unevaluatedProperties": false
}
